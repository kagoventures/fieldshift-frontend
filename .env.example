# API base, including the /api suffix. Vite reads this when the dev server
# starts and when you build. Change it, then restart or rebuild.
#
# Unset in `npm run dev`: http://localhost:5000/api
# Unset in `npm run build`: https://nasa-space-challenge-backend.onrender.com/api
VITE_API_URL=https://nasa-space-challenge-backend.onrender.com/api
